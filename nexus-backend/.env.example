# N.E.X.U.S. Backend — Environment Variables
# Copy this file to .env and fill in your values. NEVER commit .env.
# For development/CI use a Neon BRANCH connection string, never production.

# Server
PORT=5000
NODE_ENV=development

# Neon PostgreSQL (+ PostGIS / ltree / pgrouting / h3 enabled)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# JWT Authentication
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_EXPIRES_IN=7d

# Google Gemini AI (Free Tier)
# Get your free API key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend URL (for CORS + Socket.io)
FRONTEND_URL=http://localhost:3000

# Africa's Talking SMS (existing — free sandbox available)
# Sign up at: https://africastalking.com
AT_API_KEY=
AT_USERNAME=sandbox
AT_SENDER_ID=NEXUS

# Arkesel (Ghana SMS / Voice / USSD / OTP — added for citizen OTP + local-language voice)
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=NEXUS

# Cloudinary (photo uploads for field inspections)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# WhatsApp (Meta Cloud API)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=

# Open-Meteo weather API — NO KEY REQUIRED (free & open)

# ── Hazard data sources (added in Phase 1) ──────────────────────────────────
# Scheduled hazard evaluators (FIRMS 3h + rainfall 6h). Off by default.
ENABLE_HAZARD_JOBS=false
# NASA FIRMS (bushfire) — free MAP_KEY: https://firms.modaps.eosdis.nasa.gov/api/
FIRMS_MAP_KEY=
# GloFAS / Copernicus (floods) — free account: https://ewds.climate.copernicus.eu
COPERNICUS_API_KEY=
# Google Maps (geocoding / community centroids)
GOOGLE_MAPS_API_KEY=
